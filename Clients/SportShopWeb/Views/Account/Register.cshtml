@model RegisterVM
@{
    ViewData["Title"] = "Đăng ký";
}
<div class="auth card auth-wide">
    <h1>Tạo tài khoản</h1>
    <form asp-action="Register" asp-route-returnUrl="@((string)ViewBag.ReturnUrl)" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="HoTen"></label>
                <input asp-for="HoTen" required autofocus />
                <span asp-validation-for="HoTen" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="TenDangNhap"></label>
                <input asp-for="TenDangNhap" required autocomplete="username" />
                <span asp-validation-for="TenDangNhap" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" required />
                <span asp-validation-for="Email" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="SDT"></label>
                <input asp-for="SDT" type="tel" required maxlength="11" />
                <span asp-validation-for="SDT" class="field-err"></span>
            </div>
            <div class="field span-2">
                <label asp-for="DiaChi"></label>
                <input asp-for="DiaChi" placeholder="Địa chỉ nhận hàng mặc định (không bắt buộc)" />
                <span asp-validation-for="DiaChi" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="MatKhau"></label>
                <input asp-for="MatKhau" required autocomplete="new-password" />
                <span asp-validation-for="MatKhau" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="XacNhanMatKhau"></label>
                <input asp-for="XacNhanMatKhau" required autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="field-err"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Đăng ký</button>
    </form>
    <p class="center">Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@((string)ViewBag.ReturnUrl)">Đăng nhập</a></p>
</div>

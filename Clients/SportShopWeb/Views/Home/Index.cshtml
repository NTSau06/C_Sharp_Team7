@model HomeVM
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <div class="hero-text">
        <span class="hero-kicker">Dụng cụ thể thao chính hãng</span>
        <h1>Sẵn sàng cho mọi trận đấu</h1>
        <p>Bóng đá, cầu lông, gym, chạy bộ, bơi lội... Đặt hàng nhanh, giao tận nơi, thanh toán linh hoạt.</p>
        <div class="row-gap">
            <a class="btn btn-light" asp-controller="Category" asp-action="Index">Xem danh mục</a>
            <a class="btn btn-ghost" asp-controller="Search" asp-action="Index" asp-route-q="bóng">Tìm "bóng"</a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">⚽🏸🏀<br />🏋️🏃🏓</div>
</section>

@if (!string.IsNullOrEmpty(Model.ThongBao))
{
    <div class="empty card">
        <div class="empty-icon">⚠️</div>
        <p>@Model.ThongBao</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Tải lại</a>
    </div>
}

@if (Model.KhuyenMai.Count > 0)
{
    <section class="section">
        <h2>Mã giảm giá đang có</h2>
        <div class="vouchers">
            @foreach (var m in Model.KhuyenMai)
            {
                <div class="voucher">
                    <div class="voucher-pct">-@m.PhanTramGiam%</div>
                    <div>
                        <b class="voucher-code">@m.Code</b>
                        <div class="muted small">Giảm tối đa @WebHelper.Tien(m.SoTienGiamToiDa) · Đơn từ @WebHelper.Tien(m.DonToiThieu)</div>
                        <div class="muted small">HSD: @m.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="section">
    <div class="section-head">
        <h2>Danh mục sản phẩm</h2>
        <a asp-controller="Category" asp-action="Index">Xem tất cả ›</a>
    </div>
    <div class="cats">
        @foreach (var dm in Model.DanhMucs)
        {
            <a class="cat" asp-controller="Category" asp-action="Products" asp-route-maDM="@dm.MaDM" style="--c:@WebHelper.MauDanhMuc(dm.MaDM)">
                <span class="cat-icon">@WebHelper.IconDanhMuc(dm.TenDM)</span>
                <span class="cat-name">@dm.TenDM</span>
                <span class="muted small">@dm.SoSanPham sản phẩm</span>
            </a>
        }
    </div>
</section>

@if (Model.BanChay.Count > 0)
{
    <section class="section">
        <div class="section-head">
            <h2>🔥 Bán chạy</h2>
        </div>
        <div class="grid">
            @foreach (var sp in Model.BanChay)
            {
                <partial name="_ProductCard" model="sp" />
            }
        </div>
    </section>
}

<section class="section">
    <div class="section-head">
        <h2>Sản phẩm mới</h2>
        <a asp-controller="Category" asp-action="Index">Xem thêm ›</a>
    </div>
    <div class="grid">
        @foreach (var sp in Model.MoiNhat)
        {
            <partial name="_ProductCard" model="sp" />
        }
    </div>
</section>

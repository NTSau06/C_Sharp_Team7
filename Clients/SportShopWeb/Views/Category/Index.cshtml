@model List<DanhMucDTO>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Danh mục</span></nav>
<div class="page-head"><h1>Danh mục sản phẩm</h1></div>

@if (ViewBag.ThongBao != null)
{
    <div class="empty card">
        <div class="empty-icon">⚠️</div>
        <p>@ViewBag.ThongBao</p>
        <a class="btn btn-primary" asp-controller="Category" asp-action="Index">Tải lại</a>
    </div>
}
else if (Model.Count == 0)
{
    <div class="empty card"><p>Chưa có danh mục nào.</p></div>
}
else
{
    <div class="cats cats-lg">
        @foreach (var dm in Model)
        {
            <a class="cat" asp-controller="Category" asp-action="Products" asp-route-maDM="@dm.MaDM" style="--c:@WebHelper.MauDanhMuc(dm.MaDM)">
                <span class="cat-icon">@WebHelper.IconDanhMuc(dm.TenDM)</span>
                <span class="cat-name">@dm.TenDM</span>
                <span class="muted small">@dm.MoTa</span>
                <span class="cat-count">@dm.SoSanPham sản phẩm</span>
            </a>
        }
    </div>
}

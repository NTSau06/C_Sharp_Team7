@model ProductDetailVM
@{
    var sp = Model.SanPham;
    ViewData["Title"] = sp.TenSP;
    int toiDa = Math.Max(1, Math.Min(sp.SoLuongTon, SportZoneWeb.BLL.GioHangBLL.SoLuongToiDaMoiSanPham));
}
<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a> ›
    <a asp-controller="Category" asp-action="Products" asp-route-maDM="@sp.MaDM">@sp.TenDM</a> ›
    <span>@sp.TenSP</span>
</nav>

<div class="detail card">
    <div class="detail-img">
        @WebHelper.Anh(sp.HinhAnh, sp.TenSP, sp.MaDM, "thumb-lg")
    </div>
    <div class="detail-info">
        <div class="product-cat">@WebHelper.IconDanhMuc(sp.TenDM) @sp.TenDM · Mã SP: #@sp.MaSP</div>
        <h1>@sp.TenSP</h1>
        @if (Model.DanhGias.Count > 0)
        {
            <a class="rating-line" href="#danh-gia"><span class="stars" style="--p:@((Model.DiemTrungBinh / 5 * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span> @Model.DiemTrungBinh.ToString("0.0") · @Model.DanhGias.Count đánh giá</a>
        }
        <div class="detail-price">@WebHelper.Tien(sp.GiaBan)</div>

        <div class="stock">
            @if (sp.HetHang)
            {
                <span class="tag tag-bad static">Hết hàng</span>
            }
            else if (sp.SapHetHang)
            {
                <span class="tag tag-warn static">Sắp hết hàng</span>
                <span class="muted">Chỉ còn @sp.SoLuongTon sản phẩm</span>
            }
            else
            {
                <span class="tag tag-ok static">Còn hàng</span>
                <span class="muted">@sp.SoLuongTon sản phẩm có sẵn</span>
            }
            @if (sp.DaBan > 0)
            {
                <span class="muted"> · Đã bán @sp.DaBan</span>
            }
        </div>

        <form asp-controller="Cart" asp-action="Add" method="post" class="buy js-add-cart">
            <input type="hidden" name="maSP" value="@sp.MaSP" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "Product", new { id = sp.MaSP })" />
            @* A1: hết hàng => vô hiệu hóa ô số lượng và nút "Thêm vào giỏ hàng" *@
            <div class="qty">
                <button type="button" class="qty-btn" data-step="-1" disabled="@sp.HetHang" aria-label="Giảm số lượng">−</button>
                <input type="number" name="soLuong" value="1" min="1" max="@toiDa" disabled="@sp.HetHang"
                       data-ton="@sp.SoLuongTon" data-warn="#detail-warn" aria-label="Số lượng" />
                <button type="button" class="qty-btn" data-step="1" disabled="@sp.HetHang" aria-label="Tăng số lượng">+</button>
            </div>
            <button type="submit" class="btn btn-outline btn-lg" disabled="@sp.HetHang">
                @(sp.HetHang ? "Hết hàng" : "🛒 Thêm vào giỏ hàng")
            </button>
            @if (!sp.HetHang)
            {
                <button type="submit" form="buy-now-form" class="btn btn-yellow btn-lg">⚡ Mua ngay</button>
            }
            <div class="inline-warn qty-warn" id="detail-warn" role="alert" hidden></div>
        </form>
        @* "Mua ngay": tới thẳng trang đặt hàng với riêng sản phẩm này (không thêm vào giỏ).
           site.js chép số lượng đang chọn vào ô soLuong trước khi gửi. *@
        <form id="buy-now-form" class="js-buy-now" method="get" asp-controller="Checkout" asp-action="Index" hidden>
            <input type="hidden" name="maSP" value="@sp.MaSP" />
            <input type="hidden" name="soLuong" value="1" />
        </form>
        <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wish-inline">
            <input type="hidden" name="maSP" value="@sp.MaSP" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "Product", new { id = sp.MaSP })" />
            <button type="submit" class="btn btn-outline">@(Model.YeuThich ? "♥ Đã yêu thích" : "♡ Thêm vào yêu thích")</button>
        </form>
        @if (Model.TrongGio > 0)
        {
            <p class="muted small">Bạn đã có @Model.TrongGio sản phẩm này trong <a asp-controller="Cart" asp-action="Index">giỏ hàng</a>.</p>
        }

        <div class="detail-desc">
            <h3>Mô tả sản phẩm</h3>
            <p>@(string.IsNullOrWhiteSpace(sp.MoTa) ? "Đang cập nhật." : sp.MoTa)</p>
            <table class="specs">
                <tr><th>Danh mục</th><td>@sp.TenDM</td></tr>
                <tr><th>Thương hiệu</th><td>@ThuocTinhSanPham.ThuongHieu(sp)</td></tr>
                <tr><th>Kích cỡ</th><td>@string.Join(", ", ThuocTinhSanPham.KichCo(sp))</td></tr>
                <tr><th>Màu sắc</th><td>@foreach (var mau in ThuocTinhSanPham.MauSac(sp)) { <span class="swatch" style="--m:@ThuocTinhSanPham.MaMau(mau)" title="@mau"></span> <span class="swatch-name">@mau</span> }</td></tr>
                <tr><th>Giá bán</th><td>@WebHelper.Tien(sp.GiaBan)</td></tr>
                <tr><th>Tình trạng</th><td>@sp.TinhTrang</td></tr>
                <tr><th>Số lượng tồn</th><td>@sp.SoLuongTon</td></tr>
            </table>
        </div>
        <ul class="perks">
            <li>🚚 Giao hàng toàn quốc</li>
            <li>💵 Thanh toán khi nhận hàng (COD)</li>
            <li>✅ Hàng chính hãng</li>
        </ul>
    </div>
</div>

@* ---------------- Đánh giá & nhận xét (chỉ khách đã mua) *@
<section class="section card reviews" id="danh-gia">
    <h2>Đánh giá & nhận xét</h2>
    <div class="review-summary">
        <div class="review-score">
            <b>@(Model.DanhGias.Count == 0 ? "–" : Model.DiemTrungBinh.ToString("0.0"))</b><span class="muted">/5</span>
            <span class="stars" style="--p:@((Model.DiemTrungBinh / 5 * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
            <span class="muted small">@Model.DanhGias.Count đánh giá</span>
        </div>
        <div class="review-bars">
            @for (int sao = 5; sao >= 1; sao--)
            {
                int dem = Model.DemSao(sao);
                int pt = Model.DanhGias.Count == 0 ? 0 : dem * 100 / Model.DanhGias.Count;
                <div class="review-bar"><span>@sao ★</span><span class="bar"><span style="width:@(pt)%"></span></span><span class="muted small">@dem</span></div>
            }
        </div>
    </div>

    @if (!User.MaKH().HasValue)
    {
        <p class="muted"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Url.Action("Detail", "Product", new { id = sp.MaSP }) + "#danh-gia")">Đăng nhập</a> để đánh giá sản phẩm bạn đã mua.</p>
    }
    else if (!Model.DuocDanhGia)
    {
        <p class="muted">Chỉ khách hàng đã mua và nhận sản phẩm này (đơn "Đã giao hàng") mới được đánh giá.</p>
    }
    else
    {
        <form asp-controller="Product" asp-action="Review" method="post" class="review-form">
            <input type="hidden" name="maSP" value="@sp.MaSP" />
            <b>@(Model.DanhGiaCuaToi == null ? "Viết đánh giá của bạn" : "Sửa đánh giá của bạn")</b>
            <div class="star-input" role="radiogroup" aria-label="Số sao">
                @for (int sao = 5; sao >= 1; sao--)
                {
                    <input type="radio" id="sao-@sao" name="soSao" value="@sao" required checked="@(Model.DanhGiaCuaToi?.SoSao == sao)" />
                    <label for="sao-@sao" title="@sao sao">★</label>
                }
            </div>
            <textarea name="noiDung" rows="3" minlength="10" maxlength="500" required placeholder="Chia sẻ cảm nhận về chất lượng sản phẩm (10–500 ký tự)">@Model.DanhGiaCuaToi?.NoiDung</textarea>
            <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
        </form>
    }

    @if (Model.DanhGias.Count == 0)
    {
        <p class="muted">Chưa có đánh giá nào cho sản phẩm này.</p>
    }
    @foreach (var dg in Model.DanhGias)
    {
        <div class="review">
            <div class="review-head">
                <span class="avatar">@WebHelper.VietTat(dg.HoTen)</span>
                <div>
                    <b>@dg.HoTen</b> <span class="tag tag-ok static small">✔ Đã mua hàng</span><br />
                    <span class="stars" style="--p:@(dg.SoSao * 20)%"></span>
                    <span class="muted small">@dg.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
            <p>@dg.NoiDung</p>
        </div>
    }
</section>

@if (Model.LienQuan.Count > 0)
{
    <section class="section">
        <h2>Sản phẩm liên quan</h2>
        <div class="grid">
            @foreach (var item in Model.LienQuan)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

@if (Model.DaXem.Count > 0)
{
    <section class="section">
        <h2>🕘 Sản phẩm bạn đã xem</h2>
        <div class="grid">
            @foreach (var item in Model.DaXem)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

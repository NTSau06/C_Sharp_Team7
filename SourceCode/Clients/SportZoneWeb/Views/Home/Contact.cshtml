@model LienHeVM
@{
    ViewData["Title"] = "Liên hệ";
}
<nav class="breadcrumb"><a asp-action="Index">Trang chủ</a> › <span>Liên hệ</span></nav>
<div class="contact-grid">
    <section class="card form-card">
        <h1>Liên hệ với SportZone</h1>
        <p class="muted">Gửi câu hỏi hoặc góp ý, cửa hàng sẽ phản hồi qua email của bạn.</p>
        <form asp-action="Contact" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
            <div class="field"><label asp-for="HoTen"></label><input asp-for="HoTen" maxlength="100" /><span asp-validation-for="HoTen" class="field-err"></span></div>
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="100" /><span asp-validation-for="Email" class="field-err"></span></div>
            <div class="field"><label asp-for="TieuDe"></label><input asp-for="TieuDe" maxlength="150" /><span asp-validation-for="TieuDe" class="field-err"></span></div>
            <div class="field"><label asp-for="NoiDung"></label><textarea asp-for="NoiDung" rows="6" maxlength="2000"></textarea><span asp-validation-for="NoiDung" class="field-err"></span></div>
            <button type="submit" class="btn btn-primary">Gửi tin nhắn</button>
        </form>
    </section>
    <aside class="card form-card">
        <h3>Thông tin cửa hàng</h3>
        @* Cập nhật thông tin thật của cửa hàng tại đây *@
        <p>📍 Địa chỉ: (cập nhật địa chỉ cửa hàng)</p>
        <p>📞 Hotline: (cập nhật số điện thoại)</p>
        <p>✉ Email: (cập nhật email cửa hàng)</p>
        <p>🕘 Giờ làm việc: 8:00 – 21:00, tất cả các ngày trong tuần</p>
        <p class="muted small">Xem thêm <a asp-action="Faq">Câu hỏi thường gặp</a> và <a asp-action="ReturnPolicy">Chính sách đổi trả</a>.</p>
    </aside>
</div>

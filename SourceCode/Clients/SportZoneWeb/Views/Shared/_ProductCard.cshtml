@model SanPhamDTO
<div class="card product">
    <a class="product-img" asp-controller="Product" asp-action="Detail" asp-route-id="@Model.MaSP">
        @WebHelper.Anh(Model.HinhAnh, Model.TenSP, Model.MaDM)
        @if (Model.HetHang)
        {
            <span class="tag tag-bad">Hết hàng</span>
        }
        else if (Model.SapHetHang)
        {
            <span class="tag tag-warn">Sắp hết</span>
        }
    </a>
    <div class="product-body">
        <div class="product-cat">@WebHelper.IconDanhMuc(Model.TenDM) @Model.TenDM</div>
        <a class="product-name" asp-controller="Product" asp-action="Detail" asp-route-id="@Model.MaSP" title="@Model.TenSP">@Model.TenSP</a>
        <div class="product-meta">
            <span class="price">@WebHelper.Tien(Model.GiaBan)</span>
            @if (Model.DaBan > 0)
            {
                <span class="sold">Đã bán @Model.DaBan</span>
            }
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post" class="js-add-cart">
            <input type="hidden" name="maSP" value="@Model.MaSP" />
            <input type="hidden" name="soLuong" value="1" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <div class="product-actions">
                <button type="submit" class="btn btn-outline" disabled="@Model.HetHang">
                    @(Model.HetHang ? "Hết hàng" : "Thêm vào giỏ")
                </button>
                @if (!Model.HetHang)
                {
                    <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index" asp-route-maSP="@Model.MaSP">Mua ngay</a>
                }
            </div>
        </form>
    </div>
</div>

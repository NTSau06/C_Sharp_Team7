@model ProductListVM
@{
    ViewData["Title"] = Model.TieuDe;
    var f = Model.BoLoc;
    string formAction = Model.LaTrangTimKiem
        ? Url.Action("Index", "Search")
        : Url.Action("Products", "Category", new { maDM = Model.DanhMuc.MaDM });
    string xoaLoc = Model.LaTrangTimKiem
        ? Url.Action("Index", "Search", new { q = Model.TuKhoa })
        : Url.Action("Products", "Category", new { maDM = Model.DanhMuc.MaDM });

    // Đường dẫn một trang: GIỮ NGUYÊN toàn bộ bộ lọc (q, GiaTu, GiaDen, ConHang, MaDM, SapXep) và chỉ đổi Page
    Func<int, string> urlTrang = soTrangDich =>
    {
        var qs = new Dictionary<string, string>();
        if (Model.LaTrangTimKiem) qs["q"] = Model.TuKhoa;
        if (f.GiaTu.HasValue) qs["GiaTu"] = f.GiaTu.Value.ToString("0");
        if (f.GiaDen.HasValue) qs["GiaDen"] = f.GiaDen.Value.ToString("0");
        if (f.ConHang) qs["ConHang"] = "true";
        if (Model.LaTrangTimKiem && f.MaDM.HasValue) qs["MaDM"] = f.MaDM.Value.ToString();
        if (!string.IsNullOrEmpty(f.SapXep)) qs["SapXep"] = f.SapXep;
        if (soTrangDich > 1) qs["Page"] = soTrangDich.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(formAction, qs);
    };
    // Các số trang hiển thị: 1 … (trang-2 .. trang+2) … cuối
    var soTrang = new List<int>();
    for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2) soTrang.Add(i);
    }
}

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a> ›
    @if (Model.LaTrangTimKiem)
    {
        <span>Tìm kiếm</span>
    }
    else
    {
        <a asp-controller="Category" asp-action="Index">Danh mục</a>
        <text> › </text>
        <span>@Model.DanhMuc.TenDM</span>
    }
</nav>

<div class="page-head">
    <h1>
        @if (!Model.LaTrangTimKiem)
        {
            <span>@WebHelper.IconDanhMuc(Model.DanhMuc.TenDM)</span>
        }
        @Model.TieuDe
    </h1>
    @if (!string.IsNullOrEmpty(Model.MoTa))
    {
        <p class="muted">@Model.MoTa</p>
    }
</div>

<div class="listing">
    <form class="card filter" method="get" action="@formAction" id="filter-form">
    @if (Model.LaTrangTimKiem)
    {
        <input type="hidden" name="q" value="@Model.TuKhoa" />
    }
        <h3>Bộ lọc</h3>
        <label class="lbl">Khoảng giá (đ)</label>
        <div class="price-range">
            <input type="number" name="GiaTu" min="0" step="10000" placeholder="Từ" value="@(f.GiaTu.HasValue ? f.GiaTu.Value.ToString("0") : "")" />
            <span>–</span>
            <input type="number" name="GiaDen" min="0" step="10000" placeholder="Đến" value="@(f.GiaDen.HasValue ? f.GiaDen.Value.ToString("0") : "")" />
        </div>
        <div class="quick-price">
            <a href="#" data-price="0-500000">Dưới 500K</a>
            <a href="#" data-price="500000-2000000">500K – 2 triệu</a>
            <a href="#" data-price="2000000-">Trên 2 triệu</a>
        </div>
        @if (Model.LaTrangTimKiem)
        {
            <label class="lbl">Loại sản phẩm</label>
            <select name="MaDM">
                <option value="">Tất cả danh mục</option>
                @foreach (var dm in Model.DanhMucs)
                {
                    if (f.MaDM == dm.MaDM)
                    {
                        <option value="@dm.MaDM" selected>@dm.TenDM</option>
                    }
                    else
                    {
                        <option value="@dm.MaDM">@dm.TenDM</option>
                    }
                }
            </select>
        }
        <label class="check"><input type="checkbox" name="ConHang" value="true" checked="@f.ConHang" /> Chỉ hiện sản phẩm còn hàng</label>
        <button type="submit" class="btn btn-primary btn-block">Áp dụng bộ lọc</button>
        @if (f.DangLoc)
        {
            <a class="btn btn-link btn-block" href="@xoaLoc">Xóa bộ lọc</a>
        }
    </form>

    <section class="listing-main">
        <div class="toolbar">
            <span class="muted">
                @if (Model.TotalItems > 0)
                {
                    <text>Hiển thị @Model.TuSo–@Model.DenSo / <b>@Model.TotalItems</b> sản phẩm</text>
                }
                else
                {
                    <text>0 sản phẩm</text>
                }
            </span>
            <label class="sort">Sắp xếp:
                <select name="SapXep" form="filter-form" data-autosubmit>
                    @foreach (var s in SanPhamFilter.CacKieuSapXep)
                    {
                        if (f.SapXep == s.Value)
                        {
                            <option value="@s.Value" selected>@s.Text</option>
                        }
                        else
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    }
                </select>
            </label>
        </div>

        @if (!string.IsNullOrEmpty(Model.ThongBao))
        {
            <div class="empty card">
                <div class="empty-icon">🔍</div>
                <p>@Model.ThongBao</p>
                @if (f.DangLoc)
                {
                    <a class="btn btn-primary" href="@xoaLoc">Xóa bộ lọc</a>
                }
                else if (Model.LaTrangTimKiem)
                {
                    <p class="muted">Bạn có thể tham khảo các danh mục:</p>
                    <div class="chips">
                        @foreach (var dm in Model.DanhMucs)
                        {
                            <a class="chip" asp-controller="Category" asp-action="Products" asp-route-maDM="@dm.MaDM">@WebHelper.IconDanhMuc(dm.TenDM) @dm.TenDM</a>
                        }
                    </div>
                }
                else
                {
                    <a class="btn btn-outline" asp-controller="Category" asp-action="Index">Xem danh mục khác</a>
                }
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var sp in Model.SanPhams)
                {
                    <partial name="_ProductCard" model="sp" />
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pager" aria-label="Phân trang">
                    @if (Model.Page > 1)
                    {
                        <a href="@urlTrang(Model.Page - 1)" rel="prev" aria-label="Trang trước">‹ Trước</a>
                    }
                    else
                    {
                        <span class="disabled">‹ Trước</span>
                    }
                    @for (int k = 0; k < soTrang.Count; k++)
                    {
                        int trang = soTrang[k];
                        if (k > 0 && trang - soTrang[k - 1] > 1)
                        {
                            <span class="gap">…</span>
                        }
                        if (trang == Model.Page)
                        {
                            <span class="current" aria-current="page">@trang</span>
                        }
                        else
                        {
                            <a href="@urlTrang(trang)">@trang</a>
                        }
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="@urlTrang(Model.Page + 1)" rel="next" aria-label="Trang sau">Sau ›</a>
                    }
                    else
                    {
                        <span class="disabled">Sau ›</span>
                    }
                </nav>
                <div class="pager-info">Trang @Model.Page / @Model.TotalPages</div>
            }
        }
    </section>
</div>

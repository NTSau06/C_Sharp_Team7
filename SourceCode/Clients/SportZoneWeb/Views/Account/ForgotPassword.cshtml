@model QuenMatKhauVM
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth card">
    <div class="steps"><span class="active">1. Nhập tài khoản</span><span>2. Xác nhận OTP</span><span>3. Hoàn tất</span></div>
    <h1>Quên mật khẩu</h1>
    <p class="muted">Nhập tên đăng nhập hoặc email đã đăng ký. Chúng tôi sẽ gửi mã OTP 6 số tới email của bạn.</p>
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
        <div class="field">
            <label asp-for="TenDangNhapHoacEmail"></label>
            <input asp-for="TenDangNhapHoacEmail" autofocus required placeholder="VD: nguyenvana hoặc ten@gmail.com" />
            <span asp-validation-for="TenDangNhapHoacEmail" class="field-err"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Gửi mã OTP</button>
    </form>
    <p class="center"><a asp-action="Login">‹ Quay lại đăng nhập</a></p>
</div>

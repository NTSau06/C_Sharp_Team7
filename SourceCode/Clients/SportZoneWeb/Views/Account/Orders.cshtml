@model OrdersVM
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Đơn hàng của tôi</span></nav>
<div class="page-head"><h1>Đơn hàng của tôi</h1></div>

@* FR18 - lọc nhanh theo 6 trạng thái đơn hàng *@
<nav class="order-filter" aria-label="Lọc theo trạng thái">
    <a asp-action="Orders" class="@(Model.TrangThai == null ? "active" : "")">Tất cả <span class="cnt">@Model.TongSo</span></a>
    @foreach (var tt in TrangThaiDonHang.TatCa)
    {
        <a asp-action="Orders" asp-route-trangThai="@tt" class="@(Model.TrangThai == tt ? "active" : "")">@tt <span class="cnt">@Model.Dem(tt)</span></a>
    }
</nav>

@if (Model.TongSo == 0)
{
    <div class="empty card big">
        <div class="empty-icon">📄</div>
        <p>Bạn chưa có đơn hàng nào.</p>
        <a class="btn btn-primary" asp-controller="Category" asp-action="Index">Mua sắm ngay</a>
    </div>
}
else if (Model.DonHangs.Count == 0)
{
    <div class="empty card">
        <div class="empty-icon">🔍</div>
        <p>Không có đơn hàng nào ở trạng thái <b>@Model.TrangThai</b>.</p>
        <a class="btn btn-outline" asp-action="Orders">Xem tất cả đơn hàng</a>
    </div>
}
else
{
    foreach (var dh in Model.DonHangs)
    {
        <details class="card order">
            <summary>
                <span class="order-code">#@("DH" + dh.MaDH)</span>
                <span class="muted">@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                <span class="status @TrangThaiDonHang.CssClass(dh.TrangThai)">@dh.TrangThai</span>
                <b class="order-sum">@WebHelper.Tien(dh.TongTien)</b>
            </summary>
            <table class="table">
                <thead><tr><th>Sản phẩm</th><th class="num">SL</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th></tr></thead>
                <tbody>
                    @foreach (var ct in dh.ChiTiet)
                    {
                        <tr>
                            <td><a asp-controller="Product" asp-action="Detail" asp-route-id="@ct.MaSP">@ct.TenSP</a></td>
                            <td class="num">@ct.SoLuong</td>
                            <td class="num">@WebHelper.Tien(ct.DonGia)</td>
                            <td class="num">@WebHelper.Tien(ct.ThanhTien)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="3">Tạm tính</td><td class="num">@WebHelper.Tien(dh.TamTinh)</td></tr>
                    @if (dh.TienGiam > 0)
                    {
                        <tr><td colspan="3">Giảm giá (@dh.CodeMGG)</td><td class="num text-ok">- @WebHelper.Tien(dh.TienGiam)</td></tr>
                    }
                    <tr class="total"><td colspan="3">Tổng thanh toán</td><td class="num">@WebHelper.Tien(dh.TongTien)</td></tr>
                </tfoot>
            </table>
            <p class="muted small">Thanh toán: @dh.TenPTTT · Giao tới: @dh.DiaChiGiao</p>
            @if (!string.IsNullOrEmpty(dh.GhiChu))
            {
                <p class="small text-bad">Ghi chú: @dh.GhiChu</p>
            }
            <div class="order-actions">
                <a class="btn btn-sm btn-outline" asp-action="OrderDetail" asp-route-id="@dh.MaDH">Xem chi tiết & theo dõi</a>
                <form asp-action="Reorder" method="post">
                    <input type="hidden" name="id" value="@dh.MaDH" />
                    <button type="submit" class="btn btn-sm btn-primary">🛒 Mua lại</button>
                </form>
                @if (dh.TrangThai == TrangThaiDonHang.ChoXacNhan)
                {
                    <a class="btn-danger-link small" href="@Url.Action("OrderDetail", new { id = dh.MaDH })#huy">Hủy đơn</a>
                }
            </div>
        </details>
    }
}

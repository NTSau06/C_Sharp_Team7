@model DatLaiMatKhauVM
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    string otpDemo = TempData["OtpDemo"] as string;
}
<div class="auth card">
    <div class="steps"><span class="done">1. Nhập tài khoản</span><span class="active">2. Xác nhận OTP</span><span>3. Hoàn tất</span></div>
    <h1>Đặt lại mật khẩu</h1>
    <p class="muted">Nhập mã OTP đã gửi tới email <b>@Model.EmailAn</b> và mật khẩu mới.</p>
    @if (!string.IsNullOrEmpty(otpDemo))
    {
        @* Chưa có máy chủ email: hiện mã OTP để chạy thử *@
        <div class="alert alert-info">Bản chạy thử (chưa gửi email): mã OTP của bạn là <b class="otp-demo">@otpDemo</b></div>
    }
    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
        <div class="field">
            <label asp-for="MaOTP"></label>
            <input asp-for="MaOTP" class="otp-input" inputmode="numeric" maxlength="6" autocomplete="one-time-code" autofocus required placeholder="______" />
            <span asp-validation-for="MaOTP" class="field-err"></span>
        </div>
        <div class="field">
            <label asp-for="MatKhauMoi"></label>
            <input asp-for="MatKhauMoi" required autocomplete="new-password" />
            <span asp-validation-for="MatKhauMoi" class="field-err"></span>
        </div>
        <div class="field">
            <label asp-for="XacNhanMatKhau"></label>
            <input asp-for="XacNhanMatKhau" required autocomplete="new-password" />
            <span asp-validation-for="XacNhanMatKhau" class="field-err"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Đặt lại mật khẩu</button>
    </form>
    <p class="center small">Không nhận được mã? <a asp-action="ForgotPassword">Gửi lại mã OTP</a></p>
</div>

@model List<SanPhamDTO>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Yêu thích</span></nav>
<div class="page-head">
    <h1>♥ Sản phẩm yêu thích</h1>
    <p class="muted">@Model.Count sản phẩm. Bấm ♥ trên sản phẩm để thêm hoặc bỏ khỏi danh sách.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty card big">
        <div class="empty-icon">♡</div>
        <p>Bạn chưa có sản phẩm yêu thích nào.</p>
        <a class="btn btn-primary" asp-controller="Category" asp-action="Index">Khám phá sản phẩm</a>
    </div>
}
else
{
    <div class="grid">
        @foreach (var sp in Model)
        {
            <partial name="_ProductCard" model="sp" />
        }
    </div>
}

@model List<ThongBaoDTO>
@{
    ViewData["Title"] = "Thông báo";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Thông báo</span></nav>
<section class="card form-card">
    <div class="order-head">
        <h1>🔔 Thông báo của tôi</h1>
        @if (Model.Any(t => !t.DaDoc))
        {
            <form asp-action="ReadAll" method="post"><button type="submit" class="btn btn-outline">Đánh dấu tất cả đã đọc</button></form>
        }
    </div>
    @if (Model.Count == 0)
    {
        <p class="muted">Bạn chưa có thông báo nào. Khi đơn hàng đổi trạng thái, thông báo sẽ hiển thị ở đây.</p>
    }
    <ul class="notify-list">
        @foreach (var t in Model)
        {
            <li class="@(t.DaDoc ? "" : "unread")">
                <a asp-action="Open" asp-route-id="@t.MaTB" asp-route-maDH="@t.MaDH">
                    <b>@t.TieuDe</b>
                    <span>@t.NoiDung</span>
                    <small class="muted">@t.NgayTao.ToString("HH:mm dd/MM/yyyy")</small>
                </a>
            </li>
        }
    </ul>
</section>

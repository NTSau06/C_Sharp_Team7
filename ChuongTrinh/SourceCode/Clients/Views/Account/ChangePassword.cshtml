@model DoiMatKhauVM
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["TabTaiKhoan"] = "mat-khau";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Đổi mật khẩu</span></nav>

<div class="account-layout">
    <partial name="_AccountNav" />
    <section class="card form-card narrow">
        <h1>Đổi mật khẩu</h1>
        <p class="muted">Để bảo mật, vui lòng nhập mật khẩu hiện tại trước khi đặt mật khẩu mới.</p>
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
            <div class="field">
                <label asp-for="MatKhauCu"></label>
                <input asp-for="MatKhauCu" required autocomplete="current-password" />
                <span asp-validation-for="MatKhauCu" class="field-err"></span>
            </div>
            <div class="field">
                <label asp-for="MatKhauMoi"></label>
                <input asp-for="MatKhauMoi" required autocomplete="new-password" />
                <span asp-validation-for="MatKhauMoi" class="field-err"></span>
                <span class="muted small">Tối thiểu 6 ký tự, khác mật khẩu hiện tại.</span>
            </div>
            <div class="field">
                <label asp-for="XacNhanMatKhau"></label>
                <input asp-for="XacNhanMatKhau" required autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="field-err"></span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                <a class="btn btn-link" asp-action="ForgotPassword">Quên mật khẩu hiện tại?</a>
            </div>
        </form>
    </section>
</div>

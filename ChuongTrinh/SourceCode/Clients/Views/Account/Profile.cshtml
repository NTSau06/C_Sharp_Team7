@model HoSoVM
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["TabTaiKhoan"] = "ho-so";
}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> › <span>Hồ sơ cá nhân</span></nav>

<div class="account-layout">
    <partial name="_AccountNav" />
    <section class="card form-card">
        <h1>Hồ sơ cá nhân</h1>
        <p class="muted">Quản lý thông tin để nhận hàng và nhận thông báo đơn hàng.</p>
        <form asp-action="Profile" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-warn"></div>
            <div class="form-grid">
                <div class="field">
                    <label>Tên đăng nhập</label>
                    <input value="@Model.TenDangNhap" disabled />
                    <span class="muted small">Tên đăng nhập không thể thay đổi.</span>
                </div>
                <div class="field">
                    <label asp-for="HoTen"></label>
                    <input asp-for="HoTen" required maxlength="100" />
                    <span asp-validation-for="HoTen" class="field-err"></span>
                </div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" required maxlength="100" />
                    <span asp-validation-for="Email" class="field-err"></span>
                </div>
                <div class="field">
                    <label asp-for="SDT"></label>
                    <input asp-for="SDT" type="tel" required maxlength="11" />
                    <span asp-validation-for="SDT" class="field-err"></span>
                </div>
                <div class="field span-2">
                    <label asp-for="DiaChi"></label>
                    <textarea asp-for="DiaChi" rows="2" maxlength="200" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
                    <span asp-validation-for="DiaChi" class="field-err"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a class="btn btn-outline" asp-action="ChangePassword">Đổi mật khẩu</a>
            </div>
        </form>
    </section>
</div>

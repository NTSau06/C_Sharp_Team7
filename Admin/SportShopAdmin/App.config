<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Đổi "Data Source" cho đúng máy chủ SQL Server của bạn:
        .                       : SQL Server cài mặc định (Developer / Standard)
        .\SQLEXPRESS            : SQL Server Express
        (localdb)\MSSQLLocalDB  : LocalDB đi kèm Visual Studio
      Có thể sửa trực tiếp ở ô "Máy chủ SQL" trên màn hình đăng nhập.
    -->
    <add name="SportShopDB"
         connectionString="Data Source=.;Initial Catalog=SportShopDB;Integrated Security=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Thư mục lưu ảnh sản phẩm (đường dẫn tương đối tính từ thư mục chứa file .exe).
         Có thể trỏ tới thư mục wwwroot\images của project Web để dùng chung ảnh. -->
    <add key="ImageFolder" value="Images" />

    <!-- Gửi email thông tin tài khoản khi quản trị viên tạo khách hàng mới (EmailService).
         Để trống SmtpHost thì chương trình bỏ qua bước gửi email.
         Ví dụ Gmail: SmtpHost=smtp.gmail.com, SmtpPort=587, SmtpUser=địa chỉ gmail, SmtpPassword=App Password. -->
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpFrom" value="" />
    <add key="SmtpEnableSsl" value="true" />
  </appSettings>
</configuration>
